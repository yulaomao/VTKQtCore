#include <winres.h>

@VTKQTCORE_RC_ICON_BLOCK@

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @VTKQTCORE_RC_FILE_VERSION@
 PRODUCTVERSION @VTKQTCORE_RC_PRODUCT_VERSION@
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "@VTKQTCORE_RC_COMPANY_NAME@\0"
            VALUE "FileDescription", "@VTKQTCORE_RC_FILE_DESCRIPTION@\0"
            VALUE "FileVersion", "@VTKQTCORE_RC_FILE_VERSION_TEXT@\0"
            VALUE "InternalName", "@VTKQTCORE_RC_INTERNAL_NAME@\0"
            VALUE "OriginalFilename", "@VTKQTCORE_RC_ORIGINAL_FILENAME@\0"
            VALUE "ProductName", "@VTKQTCORE_RC_PRODUCT_NAME@\0"
            VALUE "ProductVersion", "@VTKQTCORE_RC_PRODUCT_VERSION_TEXT@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END